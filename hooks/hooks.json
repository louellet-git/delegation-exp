{
  "hooks": {
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/subagent-reminder.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/subagent-reminder.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/scripts/subagent-reminder.py\" || exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/stop-reminder.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/stop-reminder.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/scripts/stop-reminder.py\" || exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/commit-gate.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/commit-gate.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/scripts/commit-gate.py\" || exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
